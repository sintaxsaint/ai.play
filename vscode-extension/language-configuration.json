{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": ":$",
    "decreaseIndentPattern": "^\\s*(else|elif)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": { "pattern": ":$" },
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "offSide": true
  }
}
